# Database
# Connection pooling optimized for Vercel serverless
# connection_limit: Max connections per instance (10-15 recommended)
# pool_timeout: Connection pool timeout in seconds (20 recommended)
DATABASE_URL="postgresql://user:password@localhost:5432/ai-board?connection_limit=10&pool_timeout=20"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-generated-secret-here"

# GitHub OAuth (Development)
GITHUB_ID="Ov23liABC..."
GITHUB_SECRET="your-github-oauth-secret"

# GitHub repository configuration for default project
GITHUB_OWNER="your-github-username"
GITHUB_REPO="ai-board"

# AI Integration (future)
ANTHROPIC_API_KEY="sk-ant-..."

# GitHub Integration - Classic token with repo + workflow scopes
# Required for: Automated workflow dispatch when tickets transition between stages
# Scopes needed: repo (full repository access), workflow (trigger GitHub Actions)
GITHUB_TOKEN="ghp_YOUR_TOKEN_HERE"

# Credential Encryption (BYOK)
# AES-256-GCM master key for encrypting user AI provider credentials
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY="your-64-hex-char-encryption-key-here"

# Workflow API Authentication
# Used by GitHub Actions workflows to authenticate API calls
# Generate a secure random token: openssl rand -hex 32
# Store in GitHub Secrets as WORKFLOW_API_TOKEN
# Store in Vercel environment variables
WORKFLOW_API_TOKEN="your-secure-random-token-here"

# Application URL (for GitHub Actions workflows)
# Development: http://localhost:3000
# Production: Set as GitHub Repository Variable (APP_URL)
# This is used by workflows to call back to the API
APP_URL="http://localhost:3000"

# Optional
NODE_ENV="development"
PORT="3000"
# Cloudinary Configuration (Image Storage)
# Sign up at https://cloudinary.com (free tier: 25GB storage, 25GB bandwidth/month)
# Required for: Image attachments in tickets
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Push Notifications (VAPID Keys)
# Generate keys with: npx web-push generate-vapid-keys
# Required for: Browser push notifications for job completion and @mentions
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:notifications@ai-board.dev"

# Agent Log Capture (Vercel Blob)
# Stores gzipped JSONL transcripts of agent execution logs at
# logs/<projectId>/<ticketId>/<jobId>.jsonl.gz. Required for AIB-715
# capture/display feature. Provision in all environments (dev, preview, prod).
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Number of days to retain captured agent logs before nightly prune deletes
# both the Postgres summary row and the Vercel Blob artifact. Default 30.
LOG_RETENTION_DAYS="30"

# Admin Insights (AIB-777)
# Comma-separated list of allowlisted admin emails (case-insensitive). Empty
# or unset means no one has admin access. Edit and redeploy/restart to change.
# Example: ADMIN_ALLOWLIST_EMAILS="alice@example.com,bob@example.com"
ADMIN_ALLOWLIST_EMAILS=

# Lazy-reconciliation timeout for AdminInsightsReport rows stuck in RUNNING.
# A row whose startedAt is older than this many milliseconds is flipped to
# FAILED on the next admin page load or trigger attempt. Default 60 minutes.
INSIGHTS_RUN_TIMEOUT_MS="3600000"
